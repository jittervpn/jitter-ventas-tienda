{
  "routes": [
    {
      "src": "^/(wp-.*|wordpress.*|xmlrpc.*|\\.env.*|\\.git.*|\\.aws.*|\\.ssh.*|phpmyadmin.*|pma.*|server-status.*|cgi-bin.*|vendor/.*|.*\\.(php|PHP|asp|aspx|jsp|cgi|bak|sql|old|zip|tar|gz|env|ini|log|yml|yaml))$",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(lib|vps|root|scripts|cpanel|node_modules)(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*\\.md|package\\.json|package-lock\\.json|firestore\\.rules|vercel\\.json|\\.gitignore|\\.git/.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), usb=(), interest-cohort=()",
        "Content-Security-Policy": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://*.mercadopago.com https://*.mercadopago.com.ar https://*.mercadolibre.com; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "/admin/?",
      "dest": "/admin.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/stats",
      "dest": "/api/planes?que=stats"
    }
  ]
}
