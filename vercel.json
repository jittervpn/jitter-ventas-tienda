{
  "routes": [
    { "src": "/(lib|vps|root|scripts|cpanel|node_modules)(/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/(.*\\.md|package\\.json|package-lock\\.json|firestore\\.rules|vercel\\.json|\\.gitignore|\\.git/.*)", "status": 404, "dest": "/404.html" },
    { "src": "/auth/(request-code|verify-code)\\.php", "status": 308, "headers": { "Location": "/" } },
    { "src": "/api/(.*)", "headers": { "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff", "Referrer-Policy": "no-referrer" }, "continue": true },
    { "src": "/(.*)", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "SAMEORIGIN" }, "continue": true }
  ]
}
